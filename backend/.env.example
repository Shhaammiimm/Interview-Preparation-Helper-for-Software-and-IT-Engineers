PORT=5000

# MongoDB Atlas — Connect → Drivers → Node.js → copy connection string.
# Replace <password> with your DB user password (URL-encode special chars: @ → %40, # → %23).
# Include the database name before the query string, e.g. ...mongodb.net/interview-prep?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/interview-prep?retryWrites=true&w=majority
